{
  "output": "${IT}/out/run-debug.jsonl",
  "timeoutSeconds": 420,
  "steps": [
    {"window": [1280, 860]},
    {"tool": "import_project", "args": {"path": "${IT}/ws/demo"}},
    {"tool": "list_launch_configurations", "args": {"types": true, "filter": "application"}},
    {"tool": "set_launch_configuration", "args": {"name": "demo-main", "type": "org.eclipse.jdt.launching.localJavaApplication", "attributes": {"org.eclipse.jdt.launching.PROJECT_ATTR": "demo", "org.eclipse.jdt.launching.MAIN_TYPE": "Main"}}},
    {"tool": "launch", "args": {"name": "demo-main", "waitSeconds": 60}},
    {"tool": "set_launch_configuration", "args": {"name": "demo-main", "attributes": {"org.eclipse.jdt.launching.PROGRAM_ARGUMENTS": "boom"}}},
    {"tool": "launch", "args": {"name": "demo-main", "waitSeconds": 60}},
    {"tool": "set_launch_configuration", "args": {"name": "demo-main", "attributes": {"org.eclipse.jdt.launching.PROGRAM_ARGUMENTS": null}}},
    {"tool": "set_launch_configuration", "args": {"name": "echo-tool", "type": "org.eclipse.ui.externaltools.ProgramLaunchConfigurationType", "attributes": {"org.eclipse.ui.externaltools.ATTR_LOCATION": "C:\\Windows\\System32\\cmd.exe", "org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS": "/c echo hello from cmd", "org.eclipse.ui.externaltools.ATTR_WORKING_DIRECTORY": "${IT}/ws/demo", "org.eclipse.debug.ui.ATTR_CONSOLE_ENCODING": "MS932"}}},
    {"tool": "launch", "args": {"name": "echo-tool", "waitSeconds": 30}},
    {"tool": "get_launches"},
    {"tool": "get_console_output"},
    {"tool": "set_breakpoint", "args": {"path": "/demo/src/Main.java", "line": 6}},
    {"tool": "list_breakpoints"},
    {"tool": "launch", "args": {"name": "demo-main", "mode": "debug", "waitSeconds": 60}},
    {"sleep": 1500},
    {"tool": "read_dialog"},
    {"tool": "click", "args": {"target": "dialog", "label": "No"}},
    {"tool": "get_debug_state"},
    {"tool": "get_variable", "args": {"path": ["args"]}},
    {"tool": "debug_step", "args": {"action": "step_over"}},
    {"tool": "debug_step", "args": {"action": "step_over"}},
    {"tool": "remove_breakpoint", "args": {"path": "/demo/src/Main.java", "line": 6}},
    {"tool": "debug_step", "args": {"action": "resume"}},
    {"tool": "get_launches"},
    {"tool": "get_console_output"},
    {"tool": "debug_step", "args": {"action": "step_over"}},
    {"tool": "execute_command", "args": {"commandId": "org.eclipse.tm.terminal.connector.local.command.launch"}},
    {"sleep": 3500},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.tm.terminal.view.ui.TerminalsView"}},
    {"tool": "send_to_terminal", "args": {"text": "echo incline-terminal-test"}},
    {"tool": "send_to_terminal", "args": {"text": "", "enter": false, "waitSeconds": 1}},
    {"screenshot": "${IT}/out/run-debug.png"},
    {"exit": true}
  ]
}
