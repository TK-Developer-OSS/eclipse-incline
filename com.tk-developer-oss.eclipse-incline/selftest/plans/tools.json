{
  "output": "${IT}/out/tools.jsonl",
  "timeoutSeconds": 420,
  "steps": [
    {"window": [1280, 860]},
    {"tool": "get_workbench_state"},
    {"tool": "import_project", "args": {"path": "${IT}/ws/demo"}},
    {"tool": "list_perspectives"},
    {"tool": "open_perspective", "args": {"perspectiveId": "org.eclipse.ui.resourcePerspective"}},
    {"tool": "open_perspective", "args": {"perspectiveId": "no.such.perspective"}},
    {"tool": "list_views", "args": {"filter": "problem"}},
    {"tool": "show_view", "args": {"viewId": "org.eclipse.ui.views.ProblemView"}},
    {"tool": "show_view", "args": {"viewId": "org.eclipse.ui.navigator.ProjectExplorer"}},
    {"tool": "get_workbench_state"},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.ui.navigator.ProjectExplorer"}},
    {"tool": "select_item", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer", "path": ["demo"], "action": "expand"}},
    {"tool": "select_item", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer", "path": ["demo", "src", "Main.java"], "action": "select"}},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.ui.navigator.ProjectExplorer"}},
    {"tool": "context_menu", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer"}},
    {"tool": "context_menu", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer", "menuPath": ["Open With"]}},
    {"tool": "select_item", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer", "path": ["demo", "hello.txt"], "action": "open"}},
    {"tool": "open_file", "args": {"path": "${IT}/ws/demo/src/Main.java", "line": 5}},
    {"tool": "get_workbench_state"},
    {"tool": "read_view", "args": {"viewId": "editor", "maxItems": 20}},
    {"tool": "get_problems"},
    {"tool": "get_problems", "args": {"path": "demo", "severity": "error"}},
    {"tool": "refresh_workspace", "args": {"path": "demo"}},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.ui.views.ProblemView"}},
    {"tool": "list_commands", "args": {"filter": "new wizard"}},
    {"tool": "list_commands", "args": {"filter": "save"}},
    {"tool": "execute_command", "args": {"commandId": "org.eclipse.ui.file.saveAll"}},
    {"tool": "execute_command", "args": {"commandId": "no.such.command"}},
    {"tool": "execute_command", "args": {"commandId": "org.eclipse.ui.newWizard"}},
    {"tool": "read_dialog"},
    {"screenshot": "${IT}/out/tools-dialog.png", "of": "top"},
    {"tool": "set_text", "args": {"target": "dialog", "text": "java project"}},
    {"sleep": 800},
    {"tool": "read_dialog"},
    {"tool": "click", "args": {"target": "dialog", "label": "Cancel"}},
    {"tool": "read_dialog"},
    {"tool": "read_view", "args": {"viewId": "com.tkdevelopeross.eclipse.incline.chatView"}},
    {"screenshot": "${IT}/out/tools-window.png"},
    {"exit": true}
  ]
}
