{
  "output": "${IT}/out/c-make.jsonl",
  "timeoutSeconds": 420,
  "steps": [
    {"window": [1280, 860]},
    {"tool": "import_project", "args": {"path": "${IT}/ws/cdemo"}},
    {"tool": "set_launch_configuration", "args": {"name": "c-make", "type": "org.eclipse.ui.externaltools.ProgramLaunchConfigurationType", "attributes": {"org.eclipse.ui.externaltools.ATTR_LOCATION": "D:\\msys64\\usr\\bin\\make.exe", "org.eclipse.ui.externaltools.ATTR_WORKING_DIRECTORY": "${IT}/ws/cdemo", "org.eclipse.debug.core.environmentVariables": {"PATH": "D:\\msys64\\ucrt64\\bin;D:\\msys64\\usr\\bin;${env_var:PATH}"}}}},
    {"tool": "launch", "args": {"name": "c-make", "waitSeconds": 90}},
    {"tool": "refresh_workspace", "args": {"path": "cdemo"}},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.ui.navigator.ProjectExplorer"}},
    {"tool": "select_item", "args": {"target": "org.eclipse.ui.navigator.ProjectExplorer", "path": ["cdemo"], "action": "expand"}},
    {"tool": "set_launch_configuration", "args": {"name": "c-make", "attributes": {"org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS": "broken"}}},
    {"tool": "launch", "args": {"name": "c-make", "waitSeconds": 90}},
    {"tool": "set_launch_configuration", "args": {"name": "c-run", "type": "org.eclipse.ui.externaltools.ProgramLaunchConfigurationType", "attributes": {"org.eclipse.ui.externaltools.ATTR_LOCATION": "${IT}/ws/cdemo/hello.exe", "org.eclipse.ui.externaltools.ATTR_WORKING_DIRECTORY": "${IT}/ws/cdemo", "org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS": "one", "org.eclipse.debug.core.environmentVariables": {"PATH": "D:\\msys64\\ucrt64\\bin;${env_var:PATH}"}}}},
    {"tool": "launch", "args": {"name": "c-run", "waitSeconds": 30}},
    {"tool": "execute_command", "args": {"commandId": "org.eclipse.tm.terminal.connector.local.command.launch"}},
    {"sleep": 3500},
    {"tool": "send_to_terminal", "args": {"text": "cd /d ${IT}/ws/cdemo"}},
    {"tool": "send_to_terminal", "args": {"text": "set PATH=D:\\msys64\\ucrt64\\bin;D:\\msys64\\usr\\bin;%PATH%"}},
    {"tool": "send_to_terminal", "args": {"text": "make clean && make", "waitSeconds": 30}},
    {"tool": "send_to_terminal", "args": {"text": "hello.exe"}},
    {"tool": "send_to_terminal", "args": {"text": "make broken", "waitSeconds": 20}},
    {"screenshot": "${IT}/out/c-make-terminal.png"},
    {"tool": "list_launch_configurations", "args": {"types": true, "filter": "c/c++"}},
    {"tool": "set_launch_configuration", "args": {"name": "c-debug", "type": "org.eclipse.cdt.launch.applicationLaunchType", "attributes": {"org.eclipse.cdt.launch.PROGRAM_NAME": "${IT}/ws/cdemo/hello.exe", "org.eclipse.cdt.launch.PROJECT_ATTR": "", "org.eclipse.cdt.launch.WORKING_DIRECTORY": "${IT}/ws/cdemo", "org.eclipse.cdt.dsf.gdb.DEBUG_NAME": "D:\\msys64\\ucrt64\\bin\\gdb.exe", "org.eclipse.cdt.launch.DEBUGGER_STOP_AT_MAIN": true, "org.eclipse.cdt.launch.DEBUGGER_STOP_AT_MAIN_SYMBOL": "main", "org.eclipse.debug.core.environmentVariables": {"PATH": "D:\\msys64\\ucrt64\\bin;${env_var:PATH}"}}}},
    {"tool": "launch", "args": {"name": "c-debug", "mode": "debug", "waitSeconds": 20}},
    {"sleep": 3000},
    {"tool": "read_dialog"},
    {"tool": "click", "args": {"target": "dialog", "label": "No"}},
    {"tool": "get_launches"},
    {"tool": "get_debug_state"},
    {"tool": "show_view", "args": {"viewId": "org.eclipse.debug.ui.DebugView"}},
    {"sleep": 1500},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.debug.ui.DebugView"}},
    {"tool": "show_view", "args": {"viewId": "org.eclipse.debug.ui.VariableView"}},
    {"sleep": 1500},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.debug.ui.VariableView"}},
    {"tool": "debug_step", "args": {"action": "step_over"}},
    {"sleep": 1500},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.debug.ui.DebugView"}},
    {"tool": "read_view", "args": {"viewId": "org.eclipse.debug.ui.VariableView"}},
    {"screenshot": "${IT}/out/c-make-debug.png"},
    {"tool": "debug_step", "args": {"action": "resume"}},
    {"sleep": 2500},
    {"tool": "get_launches"},
    {"tool": "get_console_output"},
    {"tool": "terminate_launch"},
    {"exit": true}
  ]
}
